generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String
  dailyGoal       Int       @default(2000)
  theme           String    @default("system")
  dailyReminder   Boolean   @default(true)
  vibration       Boolean   @default(true)
  xp              Int       @default(0)
  level           Int       @default(1)
  streak          Int       @default(0)
  lastGoalMetDate DateTime?
  totalWater      Int       @default(0)
  createdAt       DateTime  @default(now())

  waterLogs            WaterLog[]
  notificationSettings NotificationSetting?
  achievements         UserAchievement[]
}

model NotificationSetting {
  id                String  @id @default(uuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id])
  type              String  @default("hourly") // hourly, daily, custom
  intervalInMinutes Int     @default(60)
  daysOfWeek        Int[]   @default([0, 1, 2, 3, 4, 5, 6]) // 0=Sunday, 1=Monday...
  startTime         String  @default("08:00")
  endTime           String  @default("22:00")
  enabled           Boolean @default(true)
}

model WaterLog {
  id        String   @id @default(uuid())
  amount    Int
  date      DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Achievement {
  id          String @id @default(uuid())
  key         String @unique // e.g., 'first_drop', 'streak_7'
  title       String
  description String
  icon        String
  category    String // 'onboarding', 'consistency', 'volume', etc.
  xpReward    Int    @default(100)

  users UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  user          User        @relation(fields: [userId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
}
